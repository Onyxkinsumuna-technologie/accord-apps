{
  "name": "accord-rapprochement",
  "version": "1.0.0",
  "description": "Accord - Rapprochement Recettes comptabilisées et Déclarations / Dépôts",
  "author": "KINSUMUNA MANKODILA Onyx",
  "main": "electron/main.js",
  "scripts": { "win": "electron-builder --win portable --x64 --publish never" },
  "build": {
    "appId": "app.accord.rapprochement",
    "productName": "Accord",
    "files": ["electron/**", "www/**"],
    "directories": { "output": "dist" },
    "win": { "icon": "www/icon-512.png", "artifactName": "Accord.exe" }
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "xlsx-js-style": "1.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
